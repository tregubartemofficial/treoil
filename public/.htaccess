# Apache config for thehost.ua (static Astro build)
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTP -> HTTPS is done by the nginx front end on thehost.ua. Checking %{HTTPS}
  # here would loop, because nginx talks to Apache over plain HTTP.
  # Only collapse www to the bare domain.
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://treoil.vn.ua%{REQUEST_URI} [L,R=301]

  # Add trailing slash only for real directories (/assortment -> /assortment/)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"

  # Hashed build assets never change
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain application/manifest+json
</IfModule>

AddType application/manifest+json .webmanifest
AddType image/avif .avif
AddType image/webp .webp
