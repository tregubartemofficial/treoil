---
interface Props {
  items: { name: string; href?: string }[];
}
const { items } = Astro.props;
---

<nav aria-label="Хлібні крихти">
  <ol class="m-0 flex list-none flex-wrap gap-1.5 p-0 text-sm text-muted">
    {items.map((it, i) => (
      <li class="flex gap-1.5">
        {i > 0 && (
          <span aria-hidden="true" class="text-line-strong">
            /
          </span>
        )}
        {it.href ? (
          <a href={it.href} class="text-muted">
            {it.name}
          </a>
        ) : (
          <span aria-current="page">{it.name}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
