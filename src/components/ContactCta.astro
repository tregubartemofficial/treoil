---
// Shown in place of the lead form while the `leadForm` feature flag is off.
// Keeps id="lead" so every existing #lead link still lands here.
import { site } from "../data/site";

interface Props {
  title?: string;
}
const { title = "Зв'яжіться з нами" } = Astro.props;
---

<section class="section-pad" id="lead" aria-labelledby="lead-title">
  <div class="wrap">
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))] items-center gap-8 rounded-panel bg-white p-[clamp(24px,4vw,48px)]">
      <div class="flex flex-col gap-4">
        <h2 id="lead-title" class="section-title">
          {title}
        </h2>
        <p class="lead">
          Підберемо оливу під вашу техніку, підготуємо комерційну пропозицію і відправимо Новою Поштою або привеземо на
          об'єкт.
        </p>
      </div>
      <div class="flex flex-col gap-3 nav:items-end">
        {site.phones.map((p, i) => (
          <a class={`btn ${i === 0 ? "btn-primary" : "btn-secondary"} w-full nav:w-auto`} href={p.href}>
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              class="size-5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2Z" />
            </svg>
            {p.display}
          </a>
        ))}
        <a class="btn btn-secondary w-full nav:w-auto" href={`mailto:${site.email}`}>
          {site.email}
        </a>
      </div>
    </div>
  </div>
</section>
