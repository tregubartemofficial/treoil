---
import { site } from "../data/site";
const year = new Date().getFullYear();
const link = "text-footer-link no-underline hover:text-white hover:underline";
---

<footer class="bg-ink pt-14 pb-6 text-[15px] text-footer-text" id="contacts">
  <div class="wrap grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-8">
    <div class="flex flex-col gap-3">
      <p class="text-[22px] font-bold text-white">TREOIL</p>
      <p>
        Продаж і постачання олив, мастил, технічних рідин та емульсолів {site.brands.join(", ")}. Доставка Новою Поштою
        по всій Україні.
      </p>
    </div>
    <div class="flex flex-col gap-3">
      <h2 class="text-base text-white">Контакти</h2>
      <address class="flex flex-col gap-2 not-italic">
        <a class={link} href={site.mapsUrl} target="_blank" rel="noopener">
          {site.address.city}, {site.address.street}
        </a>
        {site.phones.map((p) => (
          <a class={link} href={p.href}>
            {p.display}
          </a>
        ))}
        <a class={link} href={`mailto:${site.email}`}>
          {site.email}
        </a>
      </address>
    </div>
    <div class="flex flex-col gap-3">
      <h2 class="text-base text-white">Розділи</h2>
      <ul class="m-0 flex list-none flex-col gap-2 p-0">
        <li>
          <a class={link} href="/assortment/">
            Каталог
          </a>
        </li>
        <li>
          <a class={link} href="/dovidka/">
            Довідка по оливах
          </a>
        </li>
        <li>
          <a class={link} href="/#delivery">
            Доставка
          </a>
        </li>
        <li>
          <a class={link} href="/#lead">
            Залишити заявку
          </a>
        </li>
      </ul>
    </div>
  </div>
  <div class="wrap mt-10 border-t border-footer-line pt-5 text-[13px] text-[#9aa8bc]">
    © {year} {site.name}
  </div>
</footer>
