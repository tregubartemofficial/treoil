---
import { site } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="site-footer" id="contacts">
  <div class="wrap footer-grid">
    <div class="col">
      <p class="footer-logo">TREOIL</p>
      <p>
        Продаж і постачання олив, мастил, технічних рідин та емульсолів {site.brands.join(", ")}. Доставка
        Новою Поштою по всій Україні.
      </p>
    </div>
    <div class="col">
      <h2>Контакти</h2>
      <address>
        <a href={site.mapsUrl} target="_blank" rel="noopener">{site.address.city}, {site.address.street}</a>
        {site.phones.map((p) => <a href={p.href}>{p.display}</a>)}
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </address>
    </div>
    <div class="col">
      <h2>Розділи</h2>
      <ul>
        <li><a href="/assortment/">Каталог</a></li>
        <li><a href="/dovidka/">Довідка по оливах</a></li>
        <li><a href="/#delivery">Доставка</a></li>
        <li><a href="/#lead">Залишити заявку</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap footer-bottom">© {year} {site.name}</div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: #c9d3e0;
    padding-block: 56px 24px;
    font-size: 15px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 32px;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .footer-logo {
    font-size: 22px;
    font-weight: 700;
    color: #fff;
  }
  h2 {
    font-size: 16px;
    color: #fff;
  }
  address {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  a {
    color: #e6ecf4;
    text-decoration: none;
  }
  a:hover {
    color: #fff;
    text-decoration: underline;
  }
  .footer-bottom {
    margin-block-start: 40px;
    padding-block-start: 20px;
    border-block-start: 1px solid #26354d;
    font-size: 13px;
    color: #9aa8bc;
  }
</style>
