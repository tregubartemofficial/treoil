---
import { site } from "../data/site";

const path = Astro.url.pathname;
const links = [
  { href: "/assortment/", label: "Каталог" },
  { href: "/dovidka/", label: "Довідка" },
  { href: "/#delivery", label: "Доставка" },
  { href: "/#about", label: "Про нас" },
  { href: "/#contacts", label: "Контакти" },
];
const isCurrent = (href: string) => !href.includes("#") && path.startsWith(href);
---

<div class="bg-ink text-[13px] text-footer-text">
  <div class="wrap flex flex-wrap justify-between gap-x-6 gap-y-1 py-2">
    <span>
      {site.address.city}, {site.address.street}
    </span>
    <span class="flex flex-wrap gap-x-4 gap-y-1 [&_a]:text-footer-link [&_a]:no-underline [&_a:hover]:text-white [&_a:hover]:underline">
      {site.phones.map((p) => (
        <a href={p.href}>{p.display}</a>
      ))}
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </span>
  </div>
</div>
<header class="border-b border-line bg-white">
  <div class="wrap flex items-center justify-between gap-4 py-3.5">
    <a
      class="inline-flex min-h-11 items-center gap-2.5 text-[22px] font-bold tracking-wide text-ink no-underline hover:text-ink"
      href="/"
      aria-label="TREOIL — на головну"
    >
      <svg aria-hidden="true" viewBox="0 0 600 570" width="32" height="30" class="text-primary">
        <use href="#logo-mark"></use>
      </svg>
      <span>TREOIL</span>
    </a>

    <nav aria-label="Основна навігація">
      <button
        class="menu-button inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-ctl border border-line-strong bg-white px-3.5 font-medium text-ink nav:hidden"
        type="button"
        popovertarget="site-menu"
        aria-controls="site-menu"
      >
        <svg
          aria-hidden="true"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <span>Меню</span>
      </button>
      <ul
        id="site-menu"
        popover="auto"
        class="site-menu fixed inset-auto top-28 right-(--gutter) mt-2 max-h-[calc(100dvh-6rem)] w-[min(80dvw,20rem)] list-none overflow-auto rounded-card border border-line bg-white p-2 shadow-[0_12px_32px_rgb(15_27_45/0.14)] nav:static nav:flex nav:w-auto nav:max-h-none nav:items-center nav:gap-1 nav:overflow-visible nav:m-0 nav:border-0 nav:bg-transparent nav:p-0 nav:shadow-none nav:backdrop:hidden"
      >
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={isCurrent(l.href) ? "page" : undefined}
              class="flex min-h-11 items-center rounded-ctl px-3 py-2 font-medium text-ink-2 no-underline hover:bg-soft hover:text-ink aria-[current=page]:text-primary aria-[current=page]:underline aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-[6px]"
            >
              {l.label}
            </a>
          </li>
        ))}
        <li class="px-1 pt-2 pb-1 nav:py-0 nav:pr-0 nav:pl-3">
          <a class="btn btn-primary w-full nav:w-auto" href="#lead">
            Залишити заявку
          </a>
        </li>
      </ul>
    </nav>
  </div>
  <svg width="0" height="0" class="absolute" aria-hidden="true">
    <symbol id="logo-mark" viewBox="0 0 600 570">
      <path fill="currentColor" fill-rule="evenodd" d="M 29.2 2.4 C 8.3 9.0 -2.6 33.5 6.6 53 C 13.3 67.2 24.5 74.0 42.1 74.8 L 53 75.2 53 97.4 L 53 119.6 48.0 120.8 C 25.7 125.9 18.7 154.4 36.0 169.3 C 40.0 172.7 47.4 176 51.1 176 C 52.9 176 53 179.7 53 271.4 L 53 366.8 50.7 367.4 C 41.9 369.8 40.1 370.8 34.8 376.0 C 22.9 387.8 22.9 403.4 34.8 415.0 C 40.0 420.1 42.1 421.2 50.7 423.5 C 52.9 424.1 53 424.1 53 446.4 L 53 468.7 40.2 469.1 C 27.9 469.5 27.2 469.6 21.2 472.9 C -1.9 485.4 -5.7 515.2 13.5 532.8 C 16.6 535.6 21.5 538.8 24.7 540.1 L 30.5 542.5 127.5 542.8 C 230.6 543.1 231.9 543.0 241.3 538.3 C 258.2 529.7 265.6 507.7 257.6 490.2 C 254.2 482.9 246.4 475.0 239.2 471.7 C 234.5 469.5 234.2 469.4 173.7 469.2 L 113 468.9 113 445.8 L 113 422.8 156.2 423.0 L 199.5 423.3 204.7 421.0 C 226.7 411.3 226.5 379.9 204.5 369.8 C 199.5 367.5 198.9 367.4 156.2 367.2 L 113 366.9 113 271.4 L 113 176.0 200.2 175.7 L 287.5 175.5 291.5 173.3 C 308.7 163.9 312.2 142.1 298.5 128.4 C 289.6 119.4 295.6 120 198.3 120 L 113 120 113 97.5 L 113 75.0 236.2 74.7 L 359.5 74.5 365.2 71.8 C 394.2 58.2 394.7 18.3 366.0 4.2 L 360.5 1.5 197 1.3 C 63.0 1.1 32.7 1.3 29.2 2.4 M 420.5 116.3 C 415.2 118.8 412.9 122.3 371.9 193.5 C 327.0 271.5 319.9 283.3 302.6 310 C 283.2 339.7 275.8 355.8 270.8 379.3 C 267.8 393.1 267.5 426.9 270.3 440 C 283.6 502.9 326.0 548.1 388 565.6 C 400.7 569.2 442.9 570.3 457.7 567.4 C 539.5 551.5 597.0 471.6 585.5 389.8 C 581.6 361.8 573.2 341.4 554.4 314 C 542.1 296.1 533.7 282.0 486.5 200.1 C 451.7 139.9 439.9 120.2 437.2 118.2 C 433.1 115.1 425.1 114.2 420.5 116.3 M 422.5 175.9 C 418.5 177.6 415.6 182.3 381.7 243.5 C 362.8 277.6 342.4 313.3 336.4 323 C 313.0 360.5 307.2 376.8 306.5 406.5 C 303.8 518.8 433.1 578.0 511.0 500.0 C 535.7 475.4 548.2 444.8 548.3 409 C 548.3 380.0 542.3 361.0 524.0 332.5 C 511.7 313.3 513.1 315.8 467.0 232.4 C 451.5 204.4 437.5 180.2 436.0 178.6 C 433.0 175.5 426.3 174.2 422.5 175.9"></path>
    </symbol>
  </svg>
</header>

<script>
  // Close the narrow-layout popover after picking an in-page link.
  const menu = document.getElementById("site-menu");
  menu?.addEventListener("click", (e) => {
    if ((e.target as Element).closest("a") && menu.matches(":popover-open")) menu.hidePopover();
  });
</script>

<style>
  /* Anchor positioning has no Tailwind utilities; the earlier `top-28` is the fallback. */
  .menu-button {
    anchor-name: --menu-button;
  }
  @media (width < 860px) {
    .site-menu {
      top: anchor(--menu-button bottom);
    }
  }
</style>
