---
import { site } from "../data/site";

const path = Astro.url.pathname;
const links = [
  { href: "/assortment/", label: "Каталог" },
  { href: "/dovidka/", label: "Довідка" },
  { href: "/#delivery", label: "Доставка" },
  { href: "/#about", label: "Про нас" },
  { href: "/#contacts", label: "Контакти" },
];
const isCurrent = (href: string) => !href.includes("#") && path.startsWith(href);
---

<div class="topbar">
  <div class="wrap topbar-inner">
    <span>{site.address.city}, {site.address.street}</span>
    <span class="topbar-contacts">
      {site.phones.map((p) => <a href={p.href}>{p.display}</a>)}
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </span>
  </div>
</div>
<header class="site-header">
  <div class="wrap header-inner">
    <a class="logo" href="/" aria-label="TREOIL — на головну">
      <svg aria-hidden="true" viewBox="0 0 200 190" width="30" height="29"><use href="#logo-mark"></use></svg>
      <span>TREOIL</span>
    </a>

    <nav class="site-nav" aria-label="Основна навігація">
      <button class="menu-button" type="button" popovertarget="site-menu" aria-controls="site-menu">
        <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
        <span>Меню</span>
      </button>
      <ul id="site-menu" class="site-menu" popover="auto">
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={isCurrent(l.href) ? "page" : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
        <li class="menu-cta"><a class="btn btn-primary" href="#lead">Залишити заявку</a></li>
      </ul>
    </nav>
  </div>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="logo-mark" viewBox="0 0 200 190">
      <path fill="currentColor" d="M13 0h104a12.5 12.5 0 0 1 0 25H37.5v15H93a9.5 9.5 0 0 1 0 19H37.5v64H64a9.5 9.5 0 0 1 0 19H37.5v15H74a12.5 12.5 0 0 1 0 25H12.5a12.5 12.5 0 0 1 0-25h5V142a9.5 9.5 0 0 1 0-19V59a9.5 9.5 0 0 1 0-19V25H13a12.5 12.5 0 0 1 0-25Z"></path>
      <path fill="currentColor" fill-rule="evenodd" d="M142.5 38.5a5 5 0 0 1 8.6 0l38 65a58 58 0 1 1-96.3 1.4c6-9 11.4-17.3 15.4-24.3ZM146.8 59l-26 46.5a44 44 0 1 0 52 0Z"></path>
    </symbol>
  </svg>
</header>

<script>
  // Close the narrow-layout popover after picking an in-page link.
  const menu = document.getElementById("site-menu");
  menu?.addEventListener("click", (e) => {
    if ((e.target as Element).closest("a") && menu.matches(":popover-open")) menu.hidePopover();
  });
</script>

<style>
  .topbar {
    background: var(--ink);
    color: #c9d3e0;
    font-size: 13px;
  }
  .topbar-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 24px;
    padding-block: 8px;
  }
  .topbar-contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
  }
  .topbar a {
    color: #e6ecf4;
    text-decoration: none;
  }
  .topbar a:hover {
    text-decoration: underline;
    color: #fff;
  }
  .site-header {
    border-block-end: 1px solid var(--line);
    background: var(--bg);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 14px;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--ink);
    text-decoration: none;
    min-block-size: 44px;
  }
  .logo svg {
    color: var(--primary);
  }
  .menu-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-block-size: 44px;
    padding: 0 14px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--ink);
    font: inherit;
    font-weight: 500;
    cursor: pointer;
    anchor-name: --menu-button;
  }
  .site-menu {
    list-style: none;
    margin: 0;
    padding: 8px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    box-shadow: 0 12px 32px rgb(15 27 45 / 0.14);
    position: fixed;
    inset: auto;
    inset-block-start: 7rem;
    inset-block-start: anchor(--menu-button bottom);
    inset-inline-end: var(--gutter);
    inline-size: min(80dvw, 20rem);
    max-block-size: calc(100dvh - 6rem);
    margin-block-start: 8px;
    overflow: auto;
  }
  .site-menu a:not(.btn) {
    display: flex;
    align-items: center;
    min-block-size: 44px;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    color: var(--ink-2);
    font-weight: 500;
    text-decoration: none;
  }
  .site-menu a:not(.btn):hover {
    background: var(--bg-soft);
    color: var(--ink);
  }
  .site-menu a[aria-current="page"] {
    color: var(--primary);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  .menu-cta {
    padding: 8px 4px 4px;
  }
  .menu-cta .btn {
    inline-size: 100%;
  }

  @media (width >= 860px) {
    .menu-button {
      display: none;
    }
    .site-menu {
      position: static;
      display: flex;
      align-items: center;
      gap: 4px;
      inline-size: auto;
      max-block-size: none;
      overflow: visible;
      margin: 0;
      padding: 0;
      border: 0;
      box-shadow: none;
      background: transparent;
    }
    .site-menu::backdrop {
      display: none;
    }
    .menu-cta {
      padding: 0 0 0 12px;
    }
    .menu-cta .btn {
      inline-size: auto;
    }
  }
</style>
