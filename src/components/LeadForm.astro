---
interface Props {
  product?: string;
  title?: string;
}
const { product = "", title = "Залишити заявку" } = Astro.props;

const label = "text-[15px] font-semibold";
const note = "text-[13px] font-normal text-muted";
// user-invalid: native :user-invalid; [.user-invalid-fallback] covers browsers without it.
const control =
  "min-h-12 w-full rounded-ctl border border-line-strong bg-white px-3 py-2.5 text-ink user-invalid:border-danger user-invalid:bg-danger-bg [&.user-invalid-fallback]:border-danger [&.user-invalid-fallback]:bg-danger-bg peer";
const error = "hidden text-sm text-danger peer-user-invalid:block peer-[.user-invalid-fallback]:block";
---

<section class="section-pad bg-soft" id="lead" aria-labelledby="lead-title">
  <div class="wrap grid grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))] items-start gap-10">
    <div class="flex flex-col gap-4">
      <h2 id="lead-title" class="section-title">
        {title}
      </h2>
      <p class="lead">
        Підберемо оливу під вашу техніку, підготуємо комерційну пропозицію і відправимо Новою Поштою або привеземо на
        об'єкт. Передзвонимо протягом робочого дня.
      </p>
    </div>

    <form
      class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,220px),1fr))] gap-4 rounded-card border border-line bg-white p-[clamp(20px,3vw,28px)]"
      action="/lead.php"
      method="post"
      data-lead-form
    >
      <input type="hidden" name="product" value={product} />
      <input type="hidden" name="page" value={Astro.url.pathname} />
      <div class="absolute -left-[10000px]" aria-hidden="true">
        <label for="lead-website">Не заповнюйте це поле</label>
        <input id="lead-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="flex flex-col gap-1.5">
        <label class={label} for="lead-name">
          Ім'я
        </label>
        <input
          class={control}
          id="lead-name"
          name="name"
          type="text"
          required
          maxlength="80"
          autocomplete="name"
          data-error="lead-name-error"
        />
        <p id="lead-name-error" class={error}>
          Помилка: вкажіть, як до вас звертатися.
        </p>
      </div>

      <div class="flex flex-col gap-1.5">
        <label class={label} for="lead-phone">
          Телефон
        </label>
        <span id="lead-phone-hint" class={note}>
          Наприклад: 067 123 45 67
        </span>
        <input
          class={control}
          id="lead-phone"
          name="phone"
          type="tel"
          required
          inputmode="tel"
          autocomplete="tel"
          pattern="[+0-9\s()\-]{10,20}"
          aria-describedby="lead-phone-hint"
          data-error="lead-phone-error"
        />
        <p id="lead-phone-error" class={error}>
          Помилка: введіть номер телефону з 10 цифр, наприклад 067 123 45 67.
        </p>
      </div>

      <div class="flex flex-col gap-1.5">
        <label class={label} for="lead-city">
          Місто доставки <span class={note}>(необов'язково)</span>
        </label>
        <input class={control} id="lead-city" name="city" type="text" maxlength="80" autocomplete="address-level2" />
      </div>

      <div class="col-span-full flex flex-col gap-1.5">
        <label class={label} for="lead-message">
          Що потрібно? <span class={note}>(необов'язково)</span>
        </label>
        <textarea
          class={`${control} resize-y`}
          id="lead-message"
          name="message"
          rows="4"
          maxlength="1500"
          placeholder="Техніка, оливи, об'єм"
        >{product ? `Цікавить: ${product}` : ""}</textarea>
      </div>

      <div class="col-span-full flex flex-wrap items-center gap-4">
        <button class="btn btn-primary disabled:cursor-progress disabled:opacity-60" type="submit">
          Надіслати заявку
        </button>
        <p
          class="font-semibold empty:hidden data-[state=error]:text-danger data-[state=ok]:text-success"
          role="status"
          data-status
        ></p>
      </div>
    </form>
  </div>
</section>

<script>
  const linkError = (el: HTMLElement, shown: boolean) => {
    const errorId = el.dataset.error;
    if (!errorId) return;
    const ids = (el.getAttribute("aria-describedby") || "").split(/\s+/).filter((id) => id && id !== errorId);
    if (shown) ids.push(errorId);
    if (ids.length) el.setAttribute("aria-describedby", ids.join(" "));
    else el.removeAttribute("aria-describedby");
  };
  const sync = (el: EventTarget | null) => {
    if (!(el instanceof HTMLElement) || !el.matches("input, textarea")) return;
    let invalid = false;
    try {
      invalid = el.matches(":user-invalid");
    } catch {
      invalid = el.classList.contains("user-invalid-fallback");
    }
    el.setAttribute("aria-invalid", String(invalid));
    linkError(el, invalid);
  };

  for (const form of document.querySelectorAll<HTMLFormElement>("[data-lead-form]")) {
    const status = form.querySelector<HTMLElement>("[data-status]")!;
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    form.querySelectorAll("input, textarea").forEach((el) => sync(el));
    form.addEventListener("blur", (e) => sync(e.target), true);
    form.addEventListener("input", (e) => sync(e.target));
    form.addEventListener(
      "invalid",
      (e) => {
        (e.target as HTMLElement).classList.add("user-invalid-fallback");
        sync(e.target);
      },
      true,
    );

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      button.disabled = true;
      status.dataset.state = "";
      status.textContent = "Надсилаємо…";
      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error(data.error || "send failed");
        form.reset();
        status.dataset.state = "ok";
        status.textContent = "Дякуємо! Заявку отримано, ми скоро зателефонуємо.";
      } catch {
        status.dataset.state = "error";
        status.textContent = "Не вдалося надіслати. Зателефонуйте нам: 063 734 11 69.";
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
