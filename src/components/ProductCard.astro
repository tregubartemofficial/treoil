---
import { Image } from "astro:assets";
import { productImage, typeShort, type Product } from "../data/catalog";

interface Props {
  product: Product;
}
const { product: p } = Astro.props;
---

<li
  class="card"
  data-brand={p.brand}
  data-type={p.type}
  data-viscosity={p.viscosity.join(" ")}
>
  <div class="card-media">
    <Image
      src={productImage(p)}
      alt=""
      widths={[220, 440]}
      sizes="220px"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="chips">
    <span class="chip chip-brand">{p.brand}</span>
    <span class="chip">{typeShort[p.type]}</span>
    {p.viscosity.map((v) => <span class="chip">{v}</span>)}
  </div>
  <h3><a href={`/assortment/${p.slug}/`}>{p.title}</a></h3>
  <p class="desc">{p.description[0]}</p>
  <span class="more" aria-hidden="true">Характеристики →</span>
</li>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 20px;
    background: var(--bg);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .card:hover {
    border-color: var(--line-strong);
    box-shadow: 0 8px 24px rgb(15 27 45 / 0.08);
  }
  .card-media {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-sm);
    background: var(--bg-soft);
    display: grid;
    place-items: center;
    padding: 12px;
  }
  .card-media img {
    max-block-size: 100%;
    inline-size: auto;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  h3 {
    font-size: 19px;
  }
  h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  /* Whole card clickable via the heading link */
  h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }
  h3 a:focus-visible {
    outline: none;
  }
  h3 a:focus-visible::after {
    outline: 3px solid var(--primary);
    outline-offset: 2px;
  }
  .desc {
    font-size: 14px;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .more {
    margin-block-start: auto;
    font-weight: 600;
    font-size: 15px;
    color: var(--primary);
  }
</style>
