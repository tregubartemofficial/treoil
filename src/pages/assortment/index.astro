---
import Base from "../../layouts/Base.astro";
import ProductCard from "../../components/ProductCard.astro";
import LeadForm from "../../components/LeadForm.astro";
import { products, brands, types, viscosities, typeShort } from "../../data/catalog";
import { breadcrumbs } from "../../data/schema";
import { site } from "../../data/site";

const groups = [
  { key: "type", legend: "Тип", options: types.map((t) => ({ value: t, label: typeShort[t] })) },
  { key: "brand", legend: "Бренд", options: brands.map((b) => ({ value: b, label: b })) },
  { key: "viscosity", legend: "В'язкість SAE", options: viscosities.map((v) => ({ value: v, label: v })) },
];
const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: products.map((p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: `${site.url}/assortment/${p.slug}/`,
    name: p.title,
  })),
};
---

<Base
  title="Каталог олив і мастил"
  description={`Каталог: ${products.length} позицій моторних, трансмісійних, індустріальних олив, мастил і антифризів Prista, Unil, Orlen. Доставка Новою Поштою по Україні.`}
  jsonLd={[breadcrumbs([{ name: "Головна", path: "/" }, { name: "Каталог", path: "/assortment/" }]), itemList]}
>
  <div class="wrap page">
    <nav class="breadcrumbs" aria-label="Хлібні крихти">
      <ol>
        <li><a href="/">Головна</a></li>
        <li aria-current="page">Каталог</li>
      </ol>
    </nav>
    <h1>Каталог олив і мастил</h1>

    <div class="layout">
      <form class="filters" aria-label="Фільтри" data-filters>
        {
          groups.map((g) => (
            <fieldset>
              <legend>{g.legend}</legend>
              {g.options.map((o) => (
                <label class="opt">
                  <input type="checkbox" name={g.key} value={o.value} />
                  <span>{o.label}</span>
                </label>
              ))}
            </fieldset>
          ))
        }
        <button class="btn btn-secondary" type="reset">Скинути фільтри</button>
      </form>

      <div class="results">
        <p class="count" role="status" data-count>Знайдено: {products.length}</p>
        <ul class="grid" data-grid>
          {products.map((p) => <ProductCard product={p} />)}
        </ul>
        <p class="empty" hidden data-empty>
          Нічого не знайдено. Скиньте фільтри або <a href="#lead">залиште заявку</a> — підберемо аналог.
        </p>
      </div>
    </div>
  </div>
  <LeadForm title="Не знайшли потрібне?" />
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-filters]")!;
  const cards = [...document.querySelectorAll<HTMLElement>("[data-grid] > li")];
  const count = document.querySelector<HTMLElement>("[data-count]")!;
  const empty = document.querySelector<HTMLElement>("[data-empty]")!;
  const keys = ["type", "brand", "viscosity"] as const;

  const apply = (updateUrl = true) => {
    const data = new FormData(form);
    const sel = Object.fromEntries(keys.map((k) => [k, data.getAll(k) as string[]]));
    let shown = 0;
    for (const card of cards) {
      const ok =
        (!sel.type.length || sel.type.includes(card.dataset.type!)) &&
        (!sel.brand.length || sel.brand.includes(card.dataset.brand!)) &&
        (!sel.viscosity.length || card.dataset.viscosity!.split(" ").some((v) => sel.viscosity.includes(v)));
      card.hidden = !ok;
      if (ok) shown++;
    }
    count.textContent = `Знайдено: ${shown}`;
    empty.hidden = shown > 0;
    if (updateUrl) {
      const params = new URLSearchParams();
      keys.forEach((k) => sel[k].forEach((v) => params.append(k, v)));
      const qs = params.toString();
      history.replaceState(null, "", qs ? `?${qs}` : location.pathname);
    }
  };

  // Restore from URL (e.g. /assortment/?type=motor from the home page).
  const params = new URLSearchParams(location.search);
  for (const input of form.querySelectorAll<HTMLInputElement>("input[type=checkbox]")) {
    input.checked = params.getAll(input.name).includes(input.value);
  }
  apply(false);
  form.addEventListener("change", () => apply());
  form.addEventListener("reset", () => setTimeout(() => apply()));
</script>

<style>
  .page {
    padding-block: 32px 64px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  h1 {
    font-size: clamp(30px, 4vw, 44px);
  }
  .layout {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    align-items: flex-start;
    margin-block-start: 8px;
  }
  .filters {
    flex: 1 1 220px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  @media (width >= 900px) {
    .filters {
      position: sticky;
      inset-block-start: 16px;
      max-inline-size: 260px;
    }
  }
  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 2px 12px;
  }
  legend {
    font-weight: 700;
    margin-block-end: 6px;
    padding: 0;
  }
  .opt {
    display: flex;
    align-items: center;
    gap: 8px;
    min-block-size: 40px;
    cursor: pointer;
    flex: 1 0 45%;
    white-space: nowrap;
  }
  .opt input {
    inline-size: 20px;
    block-size: 20px;
    accent-color: var(--primary);
  }
  .results {
    flex: 999 1 560px;
    min-inline-size: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .count {
    color: var(--muted);
    font-weight: 600;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
    gap: 20px;
  }
  .empty {
    padding: 24px;
    background: var(--bg-soft);
    border-radius: var(--radius);
  }
</style>
