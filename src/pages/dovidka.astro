---
import Base from "../layouts/Base.astro";
import LeadForm from "../components/LeadForm.astro";
import { breadcrumbs, faqSchema } from "../data/schema";

const guides = [
  {
    id: "sae",
    title: "Що означає в'язкість 5W-40, 10W-40, 15W-40",
    body: [
      "Це класифікація SAE J300. Число перед літерою W (winter) — зимовий клас: чим воно менше, тим легше олива прокачується і запускає двигун на морозі. 0W і 5W підходять для сильних морозів, 15W — для м'якої зими.",
      "Число після дефісу — в'язкість за робочої температури (100 °C). 30 — тонша олива, 40 і 50 — густіша, що краще тримає плівку в навантажених і зношених двигунах.",
      "Завжди дивіться, яку в'язкість рекомендує виробник техніки. Якщо сумніваєтесь — залиште заявку, підберемо за VIN або моделлю.",
    ],
  },
  {
    id: "api-acea",
    title: "Класи API та ACEA: як читати етикетку",
    body: [
      "API — американська класифікація. Для бензинових двигунів — S (SN, SP: новіші), для дизельних — C (CI-4, CK-4). Літера, що далі за абеткою, означає сучасніші вимоги.",
      "ACEA — європейська. A/B — легкові бензинові й дизельні, C — сумісні з сажовими фільтрами (DPF) і каталізаторами (знижений вміст золи), E — вантажні дизелі.",
      "Окремо вказують допуски автовиробників: MB 229.51, VW 505 01, BMW Longlife-04 тощо. Якщо допуск вказано в сервісній книжці — обирайте оливу саме з ним.",
    ],
  },
  {
    id: "types",
    title: "Синтетика, напівсинтетика чи мінеральна",
    body: [
      "Синтетичні оливи стабільніші за високих температур і краще працюють на морозі, довше зберігають властивості. Підходять для сучасних двигунів з турбонаддувом.",
      "Напівсинтетичні — компроміс ціни та захисту для двигунів із середнім навантаженням і пробігом.",
      "Мінеральні — для старішої техніки, сільгоспмашин і там, де так вимагає виробник.",
    ],
  },
  {
    id: "gear",
    title: "Трансмісійні оливи: 75W-90, 80W-90, ATF, CVT",
    body: [
      "Для механічних коробок і мостів використовують оливи за класифікацією API GL-4 / GL-5 з в'язкістю 75W-80, 75W-90, 80W-90, 85W-140. GL-5 — для гіпоїдних передач із високим навантаженням.",
      "Для автоматичних коробок — рідини ATF (Dexron, Mercon тощо), для варіаторів — спеціальні рідини CVT. Змішувати їх із трансмісійними оливами не можна.",
      "Для тракторів і спецтехніки існують універсальні оливи UTTO і STOU, що працюють одночасно в трансмісії, гідравліці та мокрих гальмах.",
    ],
  },
  {
    id: "industrial",
    title: "Індустріальні та гідравлічні оливи, мастила",
    body: [
      "Гідравлічні оливи HLP / HM позначають за класом в'язкості ISO VG (32, 46, 68): чим більше число, тим густіша олива. Клас обирають за рекомендацією виробника обладнання й температурою роботи.",
      "Індустріальні оливи L-AN застосовують у малонавантажених вузлах верстатів, редукторах і системах змащення.",
      "Пластичні мастила (літієві, літій-комплексні, EP-2) — для підшипників, шарнірів і вузлів тертя. Літера EP означає протизадирні присадки для навантажених вузлів.",
    ],
  },
  {
    id: "antifreeze",
    title: "Антифриз: який обрати і чи можна змішувати",
    body: [
      "Антифризи відрізняються типом присадок: силікатні (G11), карбоксилатні (G12, Long Life) та гібридні. Обирайте тип, який рекомендує виробник авто.",
      "Змішувати антифризи різних типів не варто: присадки можуть реагувати між собою й утворювати осад. При зміні типу систему промивають.",
      "Концентрат розводять дистильованою водою; пропорція визначає температуру замерзання.",
    ],
  },
  {
    id: "volume",
    title: "Яке фасування обрати",
    body: [
      "Каністри 4–5 л — для легкових авто й невеликих сервісів. 10 і 20 л — для автопарків, СТО і сільгоспгосподарств.",
      "Бочки 210 л і ємності 1000 л вигідніші за ціною літра — для підприємств, генераторних і когенераційних установок, великих автопарків.",
    ],
  },
];

const faq = [
  {
    q: "Чи доставляєте ви за межі Вінниці?",
    a: "Так. Відправляємо Новою Поштою в будь-яке місто України. У Вінниці та області можемо привезти на об'єкт.",
  },
  {
    q: "Як дізнатися, яка олива потрібна для моєї техніки?",
    a: "Подивіться в'язкість і допуск у сервісній книжці або залиште заявку на сайті з моделлю техніки — ми підберемо оливу.",
  },
  {
    q: "Чи працюєте ви з підприємствами?",
    a: "Так, готуємо комерційні пропозиції для підприємств, автопарків і сервісів, а за потреби приїжджаємо для технічної консультації.",
  },
  {
    q: "Які бренди у вас є?",
    a: "Texaco, Unil, Prista Oil та Orlen Oil — моторні, трансмісійні, індустріальні оливи, мастила й антифризи.",
  },
];
---

<Base
  title="Довідка: як підібрати оливу"
  description="Як читати в'язкість SAE (5W-40), класи API та ACEA, чим відрізняються синтетичні й мінеральні оливи, трансмісійні, гідравлічні оливи та антифризи."
  jsonLd={[
    breadcrumbs([
      { name: "Головна", path: "/" },
      { name: "Довідка", path: "/dovidka/" },
    ]),
    faqSchema(faq),
  ]}
>
  <div class="wrap page">
    <nav class="breadcrumbs" aria-label="Хлібні крихти">
      <ol>
        <li><a href="/">Головна</a></li>
        <li aria-current="page">Довідка</li>
      </ol>
    </nav>
    <h1>Довідка: як підібрати оливу</h1>
    <p class="lead">Коротко про маркування олив і рідин, щоб легше зорієнтуватися в каталозі.</p>

    <div class="accordion">
      {
        guides.map((g) => (
          <details id={g.id}>
            <summary>{g.title}</summary>
            <div class="content">
              {g.body.map((t) => (
                <p>{t}</p>
              ))}
            </div>
          </details>
        ))
      }
    </div>

    <h2 class="section-title faq-title">Часті питання</h2>
    <div class="accordion">
      {
        faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <div class="content">
              <p>{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>

    <p class="cta">
      Не знайшли відповідь? <a href="/assortment/">Перегляньте каталог</a> або залиште заявку — підкажемо.
    </p>
  </div>
  <LeadForm title="Допомогти з вибором?" />
</Base>

<script>
  // Open the section linked by #hash (e.g. /dovidka/#sae).
  const open = () => {
    const el = location.hash && document.getElementById(location.hash.slice(1));
    if (el instanceof HTMLDetailsElement) el.open = true;
  };
  open();
  addEventListener("hashchange", open);
</script>

<style>
  .page {
    padding-block: 32px 64px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-inline-size: 880px;
  }
  h1 {
    font-size: clamp(30px, 4vw, 44px);
  }
  .accordion {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-block-start: 8px;
  }
  details {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
  }
  details[open] {
    border-color: var(--line-strong);
  }
  summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    min-block-size: 56px;
    padding: 14px 20px;
    font-weight: 600;
    font-size: 17px;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: "+";
    flex: none;
    font-size: 24px;
    line-height: 1;
    color: var(--primary);
  }
  details[open] summary::after {
    content: "−";
  }
  .content {
    padding: 0 20px 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--ink-2);
  }
  .faq-title {
    margin-block-start: 32px;
  }
  .cta {
    margin-block-start: 16px;
  }
</style>
