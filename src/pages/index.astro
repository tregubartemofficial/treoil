---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import ProductCard from "../components/ProductCard.astro";
import LeadForm from "../components/LeadForm.astro";
import PackIcon from "../components/PackIcon.astro";
import HeroArt from "../components/HeroArt.astro";
import Reviews from "../components/Reviews.astro";
import { products, types, typeLabels, typeShort, assetImage } from "../data/catalog";
import { site } from "../data/site";
import { localBusiness, webSite } from "../data/schema";

const featuredSlugs = [
  "prista-ultra-plus-5w-40",
  "prista-super-hd-15w-40",
  "unil-opaljet-longlife-3-5w30",
  "unil-matic-dx-vi",
  "orlen-hydrol-l-hm-hlp",
  "orlen-liten-ep-2",
];
const featured = featuredSlugs.map((s) => products.find((p) => p.slug === s)!).filter(Boolean);
const counts = Object.fromEntries(types.map((t) => [t, products.filter((p) => p.type === t).length]));

const packs = [
  { kind: "can-s", label: "Каністра 4 л" },
  { kind: "can-m", label: "Каністра 10 л" },
  { kind: "can-l", label: "Каністра 20 л" },
  { kind: "barrel", label: "Бочка 210 л" },
  { kind: "ibc", label: "Ємність 1000 л" },
] as const;
const brandLogos = [
  { img: "Texaco.png", name: "Texaco" },
  { img: "Unil.png", name: "Unil" },
  { img: "Prista.png", name: "Prista Oil" },
  { img: "Orlen.png", name: "Orlen Oil" },
];
---

<Base title={site.name} jsonLd={[localBusiness, webSite]}>
  <section class="px-2 pt-2 sm:px-4 sm:pt-4">
    <div class="overflow-hidden rounded-panel bg-primary text-white">
      <div class="wrap grid grid-cols-[repeat(auto-fit,minmax(min(100%,380px),1fr))] items-center gap-8 py-[clamp(40px,7vw,80px)]">
        <div class="flex flex-col gap-6">
          <p class="m-0 inline-flex w-fit items-center gap-2 rounded-full bg-white/15 px-3.5 py-1.5 text-sm font-medium">
            <span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>
            Доставка Новою Поштою по всій Україні
          </p>
          <h1 class="text-[clamp(36px,6vw,72px)] leading-[1.02] font-extrabold tracking-[-0.02em]">
            Оливи та мастила для бізнесу
          </h1>
          <p class="max-w-xl text-[clamp(17px,2vw,20px)] leading-normal text-on-primary-soft">
            Моторні, трансмісійні, гідравлічні та індустріальні оливи, мастила й технічні рідини{" "}
            {site.brands.join(", ")}. Підберемо під техніку, підготуємо пропозицію й привеземо на об'єкт у Вінниці або
            відправимо по Україні.
          </p>
          <ul class="m-0 flex list-none flex-wrap gap-2 p-0 text-sm font-medium">
            <li class="rounded-full border border-white/25 px-3 py-1.5">Каністри 4–20 л</li>
            <li class="rounded-full border border-white/25 px-3 py-1.5">Бочки 210 л</li>
            <li class="rounded-full border border-white/25 px-3 py-1.5">Ємності 1000 л</li>
            <li class="rounded-full border border-white/25 px-3 py-1.5">Виїзд спеціаліста</li>
          </ul>
          <div class="flex flex-wrap gap-3">
            <a class="btn btn-accent" href="/assortment/">
              Обрати оливу
            </a>
            <a class="btn btn-on-primary" href="#lead">
              Залишити заявку
            </a>
            <a class="btn btn-on-primary" href={site.phones[0].href}>
              {site.phones[0].display}
            </a>
          </div>
        </div>
        <div>
          <HeroArt />
        </div>
      </div>
    </div>
  </section>

  <section class="wrap pt-4" aria-label="Бренди">
    <ul class="m-0 grid list-none grid-cols-2 gap-3 p-0 sm:grid-cols-4">
      {brandLogos.map((b) => (
        <li class="grid h-24 place-items-center rounded-card bg-white px-4">
          <Image
            src={assetImage(b.img)}
            alt={b.name}
            height={56}
            densities={[1, 2]}
            loading="lazy"
            class="h-12 w-auto object-contain"
          />
        </li>
      ))}
    </ul>
  </section>

  <section class="section-pad">
    <div class="wrap flex flex-col gap-5">
      <h2 class="section-title">Категорії</h2>
      <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(100%,230px),1fr))] gap-4 p-0">
        {types.map((t) => (
          <li>
            <a
              href={`/assortment/?type=${t}`}
              class="group flex h-full flex-col gap-1 rounded-card bg-white p-6 text-ink no-underline transition-colors hover:bg-primary hover:text-white"
            >
              <span class="font-display text-xl font-bold">{typeShort[t]}</span>
              <span class="text-sm text-muted group-hover:text-on-primary-soft">{typeLabels[t]}</span>
              <span class="mt-3 w-fit rounded-full bg-accent px-2.5 py-0.5 text-sm font-semibold text-ink">
                {counts[t]} позицій
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-pad pt-0">
    <div class="wrap flex flex-col gap-5">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 class="section-title">Популярні товари</h2>
        <a class="font-semibold" href="/assortment/">
          Весь каталог ({products.length}) →
        </a>
      </div>
      <ul class="card-grid">
        {featured.map((p) => (
          <ProductCard product={p} />
        ))}
      </ul>
    </div>
  </section>

  <section class="section-pad" id="delivery">
    <div class="wrap grid grid-cols-[repeat(auto-fit,minmax(min(100%,380px),1fr))] items-center gap-10">
      <div class="flex flex-col gap-5">
        <h2 class="section-title">Доставка та фасування</h2>
        <p class="lead">
          Відправляємо Новою Поштою в будь-яке місто України. У Вінниці та області привеземо безпосередньо на об'єкт. За
          потреби приїдемо уточнити технічні питання й скласти комерційну пропозицію.
        </p>
        <p class="lead">Оливу фасуємо в каністри 4, 10 і 20 літрів, бочки 210 літрів та ємності на 1000 літрів.</p>
      </div>
      <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(112px,1fr))] gap-3 p-0">
        {packs.map((p) => (
          <li class="flex flex-col items-center justify-end gap-3 rounded-card bg-white px-2 pt-5 pb-4 text-center text-sm font-semibold">
            <PackIcon kind={p.kind} label={p.label} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-pad pt-0" id="about">
    <div class="wrap grid grid-cols-[repeat(auto-fit,minmax(min(100%,380px),1fr))] items-center gap-10">
      <div class="flex flex-col gap-5">
        <h2 class="section-title">Про нас</h2>
        <p class="lead">
          TREOIL — компанія з Вінниці, що продає та постачає оливи, мастила, технічні рідини й емульсоли для токарних
          робіт від {site.brands.join(", ")}.
        </p>
        <p class="lead">
          В асортименті автомобільні оливи для транспорту та стаціонарних установок, оливи для газових
          двигунів-генераторів і когенераційних установок, промислові мастила, емульсоли, гас, нефрас, уайт-спірит.
          Трансформаторні, компресорні та турбінні оливи, оливи для систем кондиціонування й холодильного обладнання,
          термостійкі мастила та мастила для електромоторів.
        </p>
        <p>
          <a href="/dovidka/">Як підібрати оливу — довідка →</a>
        </p>
      </div>
      <div class="aspect-4/3 overflow-hidden rounded-panel bg-white">
        <iframe
          title={`Карта: TREOIL, ${site.address.city}, ${site.address.street}`}
          src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d6101.428664284915!2d28.42624796042512!3d49.23700397727064!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x472d5da73e9773dd%3A0xa89b208970bd654a!2z0KLRgNC10L7QudC7!5e0!3m2!1suk!2sua!4v1690721689427!5m2!1suk!2sua"
          loading="lazy"
          class="size-full border-0"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>

  <Reviews />

  <LeadForm />
</Base>
